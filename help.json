{
  "title": "MONSTER PHASE",
  "children": [
    {
      "title": "Chain",
      "lines": [
        "Pre delay > formant",
        "> crush > resonant",
        "low-pass > bass >",
        "tube > post delay.",
        "Stereo all through;",
        "after the BITRAZER",
        "patch MONSTER PHASE."
      ]
    },
    {
      "title": "Page 1",
      "lines": [
        "1 MIX   dry <-> wet",
        "2 CRUSH sample rate",
        "  (100% = clean)",
        "3 CUTOFF 120Hz-18kHz",
        "4 RESO  resonance",
        "5 VOWEL a i u e o",
        "6 DRIVE tube",
        "7 BASS  low boost",
        "8 DELAY post delay"
      ]
    },
    {
      "title": "Page 2",
      "lines": [
        "1 PRE T  pre delay",
        "2 PRE FB feedback",
        "3 PRE MX dry/wet",
        "4 POST T post delay",
        "5 POST FB feedback",
        "6 WIDTH stereo",
        "7 VOW AMT formant",
        "8 LEVEL output dB"
      ]
    },
    {
      "title": "Stereo",
      "lines": [
        "WIDTH spreads L/R:",
        "pre delay times,",
        "vowel, crush clock,",
        "post delay times",
        "and cross feedback.",
        "WIDTH 0 = mono in",
        "stays mono."
      ]
    }
  ]
}
