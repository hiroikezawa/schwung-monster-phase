{
  "id": "monster-phase",
  "name": "MONSTER PHASE",
  "abbrev": "MPHS",
  "version": "0.1.0",
  "description": "Port of the AIRA Modular Customizer patch BITRAZER_MONSTER_PHASE for the Roland BITRAZER: two SHORT DELAYs, FORMANT FILTER, TUBE CLIP, 3 BAND EQ and COMPRESSOR patched around the BITRAZER crusher, run as a data-driven graph from the saved patch file. Knob 1 MIX, knobs 2-7 the pedal's GRF1-6, knob 8 delay TIME. Wiring traced from the screenshot (approximate). Works in track slots and in Master FX",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "monster-phase.so",
  "component_type": "audio_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "audio_out": true,
    "midi_in": false,
    "midi_out": false,
    "chain_params": [
      {"key": "mix", "name": "Mix", "short_name": "MIX", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1.0, "unit": "%", "display_format": "%.0f"},
      {"key": "g1_srate", "name": "GRF1 Sample Rate", "short_name": "G1 SR", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7, "unit": "%", "display_format": "%.0f"},
      {"key": "g2_cutoff", "name": "GRF2 Filter Cutoff", "short_name": "G2 CUT", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.9, "unit": "%", "display_format": "%.0f"},
      {"key": "g3_formant", "name": "GRF3 Formant 1", "short_name": "G3 FMT", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.0, "unit": "%", "display_format": "%.0f"},
      {"key": "g4_low", "name": "GRF4 EQ Low", "short_name": "G4 LOW", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.0, "unit": "%", "display_format": "%.0f"},
      {"key": "g5_type", "name": "GRF5 LPF/HPF", "short_name": "G5 TYP", "type": "enum", "options": ["LPF", "HPF"], "default": "LPF"},
      {"key": "g6_bypass", "name": "GRF6 Bypass", "short_name": "G6 BYP", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"},
      {"key": "time", "name": "Delay Time", "short_name": "TIME", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1.0, "unit": "%", "display_format": "%.0f"}
    ]
  }
}
